  "_l624_tube = lambda: (cmd.load_cgo([6.0, 0.8, 0.8, 0.8, 66.0] + [p[i] + _l624_c[i] for p in [(-14.0, -8.0, 0.0), (-5.0, 14.0, 4.0), (5.0, -14.0, -4.0), (14.0, 8.0, 0.0)] for i in range(3)], 'tube', zoom=0), cmd.set('cartoon_tube_radius', 1.5))",
  "cmd.set('metal_light_air_time', 2.0)"
