  "_l624_s = _l624_math.sqrt(sum((b - a) ** 2 for a, b in zip(_l624_mn, _l624_mx))) / 2.0",
  "_l624_opt = lambda name, value: cmd.set(name, value) if name in cmd.setting.get_name_list() else None",
  "if not hasattr(cmd, '_l624_set'): cmd._l624_set = cmd.set_lights",
  "cmd.set_lights = lambda rig, _c=cmd: _c._l624_set(rig if getattr(_c, '_l624_rig', None) is None else (_c._l624_rig(rig) if callable(_c._l624_rig) else _c._l624_rig))",
  "_l624_spot = {'name': 'spot', 'orbit': -50.0, 'pitch': 45.0, 'radius': 3.0, 'beam': 40.0, 'softness': 0.45, 'color': [1.0, 0.8, 0.55], 'intensity': 2.0, 'highlight': 0.6, 'shadow': False}",
  "_l624_fill = {'name': 'fill', 'orbit': 60.0, 'pitch': 0.0, 'radius': 3.0, 'beam': 60.0, 'softness': 0.8, 'intensity': 0.6, 'highlight': 0.3}",
  "_l624_air = lambda **kw: dict({'haze': 0.0, 'dust': 0.0, 'dust_size': 0.35, 'dust_speed': 1.0, 'scatter': 0.55, 'seed': 7}, **kw)",
  "_l624_make = lambda lights, **air: {'version': 1, 'enabled': True, 'ambient': 0.06, 'classic': 0.0, 'centre': list(_l624_c), 'size': _l624_s, 'lights': lights, 'air': _l624_air(**air)}",
  "_l624_2l = lambda shadow=False, **air: _l624_make([dict(_l624_spot, shadow=shadow), _l624_fill], **air)",
